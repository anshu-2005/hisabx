# ==============================================================================
# HisabX Enterprise SaaS Configuration Environment
# ==============================================================================

# Core Application Server
PORT=3000
NODE_ENV=production
APP_URL=https://app.hisabx.com
CORS_ORIGIN=https://app.hisabx.com

# Multi-Tenant PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://hisabx_user:hisabx_secure_pass_2026@localhost:5432/hisabx_production?schema=public"

# Redis Cache & Rate-Limiter
REDIS_URL="redis://localhost:6379"

# Security & Authentication (JWT Secret must be >= 32 characters in production)
JWT_SECRET="hisabx_ultra_secure_jwt_secret_32_characters_long_key_2026!"
JWT_EXPIRES_IN="7d"

# Regional Fintech Formatting
DEFAULT_CURRENCY="INR"
DEFAULT_TIMEZONE="Asia/Kolkata"

# Automated Android / Tasker Webhook Bridge Secret
UPI_WEBHOOK_SECRET="whsec_production_secret_key_849281"

# SaaS Billing & Monetization (Razorpay for India / Stripe International)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxx"

# Transactional Email (Resend / SendGrid / SMTP)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxx"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="HisabX Finance <no-reply@hisabx.com>"
